# Used ONLY for docker compose interpolation. Never referenced via env_file:
# `python scripts/tl.py init` copies this to .env and replaces every change-me with a random secret.
COMPOSE_PROJECT_NAME=trustline
# eu = full two-region stack; empty = lite (ap-south only)
COMPOSE_PROFILES=
PG_OWNER_PASSWORD=change-me
PG_INGEST_PASSWORD=change-me
PG_WORKER_PASSWORD=change-me
PG_API_PASSWORD=change-me
NATS_INGEST_PASSWORD=change-me
NATS_WORKER_PASSWORD=change-me
NATS_API_PASSWORD=change-me
JWT_SECRET=change-me
DEMO_PASSWORD=trustline-demo
# preissued | token
ENROL_MODE=preissued
ENROL_TOKEN_ACME=change-me
ENROL_TOKEN_GLOBEX=change-me
# Tier 1 only: each key is passed ONLY to its own site's collector
HMAC_KEY_ACME=change-me-hex
HMAC_KEY_GLOBEX=change-me-hex
# off|http_push|http_poll|sse|ws|udp|file
ORGANISER_MODE=off
ORGANISER_URL=
ORGANISER_TOKEN=
WINDOW_SECONDS=5
BATCH_INTERVAL_MS=1000
HEARTBEAT_SECONDS=5
OFFLINE_TIMEOUT_SECONDS=45
STALE_AFTER_SECONDS=30
WARMUP_SECONDS=300
WITH_NER=0
